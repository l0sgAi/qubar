-- 由 Ansible 渲染（root:deploy 0640，不含密钥）。幂等，在以下时机重跑：
--   Ansible 运行（roles.sql 之后）、db-migrate.sh 迁移之后（新表补授权、新 CDC 表进 dbz_pub）、
--   migrate-pg.sh / 手工恢复数据之后。
\set ON_ERROR_STOP on

ALTER DATABASE qubar OWNER TO qubar_owner;
REVOKE ALL ON DATABASE qubar FROM PUBLIC;
GRANT CONNECT, TEMPORARY ON DATABASE qubar TO qubar_web_app;
GRANT CONNECT ON DATABASE qubar TO debezium;

CREATE SCHEMA IF NOT EXISTS domains AUTHORIZATION qubar_owner;
ALTER SCHEMA domains OWNER TO qubar_owner;
REVOKE CREATE ON SCHEMA public FROM PUBLIC;

GRANT USAGE ON SCHEMA domains TO qubar_web_app, debezium;
GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA domains TO qubar_web_app;
GRANT USAGE, SELECT, UPDATE ON ALL SEQUENCES IN SCHEMA domains TO qubar_web_app;
GRANT SELECT ON ALL TABLES IN SCHEMA domains TO debezium;

-- 之后 qubar_owner 新建的表自动带权限（DDL 只用 qubar_owner 执行）
ALTER DEFAULT PRIVILEGES FOR ROLE qubar_owner IN SCHEMA domains
  GRANT SELECT, INSERT, UPDATE, DELETE ON TABLES TO qubar_web_app;
ALTER DEFAULT PRIVILEGES FOR ROLE qubar_owner IN SCHEMA domains
  GRANT USAGE, SELECT, UPDATE ON SEQUENCES TO qubar_web_app;
ALTER DEFAULT PRIVILEGES FOR ROLE qubar_owner IN SCHEMA domains
  GRANT SELECT ON TABLES TO debezium;

-- Debezium publication（connector 里 publication.autocreate.mode=disabled）：只纳入已存在的表
DO $$
DECLARE
  wanted text[] := ARRAY[{% for t in cdc_tables %}'{{ t }}'{% if not loop.last %}, {% endif %}{% endfor %}];
  present text;
BEGIN
  SELECT string_agg(format('domains.%I', t), ', ')
    INTO present
    FROM unnest(wanted) AS t
   WHERE to_regclass('domains.' || quote_ident(t)) IS NOT NULL;

  IF present IS NULL THEN
    RAISE NOTICE 'dbz_pub: domains 下还没有 CDC 表，跳过（迁移数据后重跑）';
  ELSIF EXISTS (SELECT 1 FROM pg_publication WHERE pubname = 'dbz_pub') THEN
    EXECUTE 'ALTER PUBLICATION dbz_pub SET TABLE ' || present;
  ELSE
    EXECUTE 'CREATE PUBLICATION dbz_pub FOR TABLE ' || present;
  END IF;
END $$;
