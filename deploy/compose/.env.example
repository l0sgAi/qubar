# 生产 .env 模板。真实值放 GitHub Environment "production" 的 secret PROD_ENV_FILE（整份文件内容），
# CI 每次部署把它写到服务器 /opt/qubar/.env（0600）。不要提交真实值。
# 随机值：openssl rand -hex 24   （密码用 hex，避免特殊字符在 URL/DSN 里出问题）

# ---- 镜像 ----
QUBAR_IMAGE=ghcr.io/l0sgai/qubar
# QUBAR_TAG 由 deploy.sh 传入，不写在这里

# ---- 对外域名（无末尾斜杠）----
PUBLIC_API_URL=https://api.example.com
PUBLIC_WEB_URL=https://www.example.com
CORS_ALLOWED_ORIGINS=https://www.example.com
S3_PUBLIC_DOMAIN=media.example.com

# ---- PostgreSQL ----
PG_SUPERUSER_PASSWORD=
PG_OWNER_PASSWORD=
PG_APP_PASSWORD=
PG_DEBEZIUM_PASSWORD=

# ---- Redis ----
REDIS_PASSWORD=

# ---- 应用密钥 ----
# openssl rand -base64 32 。⚠️ 不支持轮换，丢失=已加密的 AI 机器人 api_key 全部作废，务必离线备份。
DATA_KEY=
MAILTRAP_API_TOKEN=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=

# ---- 对象存储：Cloudflare R2（S3 兼容）----
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_BUCKET=qubar-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- 搜索链路版本（以本地已跑通的组合为准）----
# ES_VERSION：curl localhost:9200 的 version.number，且 https://release.infinilabs.com 有同版本 IK
ES_VERSION=
# Debezium Connect 镜像 tag（quay.io/debezium/connect）与 Confluent ES sink 版本
DEBEZIUM_TAG=
ES_SINK_VERSION=
# 建议固定：REDPANDA_TAG=  CLOUDFLARED_TAG=

# ---- Cloudflare Tunnel（terraform output -raw tunnel_token）----
CLOUDFLARE_TUNNEL_TOKEN=

# ---- 备份（R2，独立 bucket + 独立 API token，只给该 bucket 读写）----
BACKUP_R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
BACKUP_R2_BUCKET=qubar-backup
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
# 可选：age 公钥（age-keygen 生成，私钥离线保存）。设置后备份先加密再上传。
BACKUP_AGE_RECIPIENT=
BACKUP_RETENTION_DAYS=14
